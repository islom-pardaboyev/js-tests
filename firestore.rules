rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // The one admin: a VERIFIED email. Unverified password accounts never qualify,
    // so nobody can claim this address by signing up first.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'ipardaboyev574@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Profiles: each user manages their own; the admin can read everyone.
    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(uid) && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // Question bank: any signed-in user can read (exams draw from it); only the admin edits.
    // NOTE: readers receive the answers and hidden tests of what they draw. See README "Threat model".
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow create, update, delete: if isAdmin();
    }

    // Attempts: users read and write only their own; the admin can read all.
    match /attempts/{attemptId} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Certificates: anyone can verify one by ID (get), only the admin can list.
    // Created by the owner, then immutable.
    match /certificates/{certId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
